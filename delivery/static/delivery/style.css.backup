/* ============================================
   FinalMealmate - Swiggy/Uber Eats Inspired CSS
   Premium Food Delivery App Styling
   ============================================ */

/* CSS Variables */
:root {
    /* Colors */
    --primary: #FF5200;
    --primary-dark: #e04800;
    --primary-light: #fff3ee;
    --green: #1BA672;
    --bg: #F2F2F7;
    --card-bg: #FFFFFF;
    --text-primary: #1C1C1C;
    --text-secondary: #686B78;
    --border: #E9E9EB;
    --shadow: 0 4px 16px rgba(0,0,0,0.08);
    
    /* Border Radius */
    --radius-card: 18px;
    --radius-btn: 10px;
    --radius-input: 12px;
    
    /* Transitions */
    --transition: all 0.2s ease;
}

/* Full CSS Reset */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Google Fonts - Poppins */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');

/* ============================================
   Landing Page - Hero Section
   ============================================ */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: rgba(0, 0, 0, 0.55) url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600') center/cover no-repeat;
    text-align: center;
    color: #fff;
    padding: 2rem;
    animation: fadeUp 0.8s ease;
}

.hero-content {
    max-width: 800px;
    animation: fadeUp 0.6s ease 0.2s both;
}

.hero-logo {
    font-size: 60px;
    margin-bottom: 1.5rem;
}

.hero-title {
    font-size: 56px;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -1px;
    color: #fff;
}

.hero-tagline {
    font-size: 18px;
    margin-bottom: 2.5rem;
    opacity: 0.8;
    font-weight: 400;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.btn {
    border: none;
    border-radius: var(--radius-btn);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
    display: inline-block;
    font-family: 'Poppins', sans-serif;
}

.btn-primary {
    background-color: var(--primary);
    color: #fff;
    height: 52px;
    width: 180px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-primary:hover {
    background-color: var(--primary-dark);
    transform: translateY(-2px);
}

.btn-outline-white {
    background-color: transparent;
    color: #fff;
    border: 2px solid #fff;
    height: 52px;
    width: 180px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.btn-outline-white:hover {
    background-color: #fff;
    color: var(--text-primary);
    transform: translateY(-2px);
}

/* ============================================
   Navigation Bar
   ============================================ */
.navbar {
    background-color: #fff;
    position: sticky;
    top: 0;
    z-index: 1000;
    height: 70px;
    border-bottom: 1px solid var(--border);
    transition: box-shadow 0.3s ease;
}

.navbar.scrolled {
    box-shadow: var(--shadow);
}

.navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--primary);
    font-weight: 700;
    font-size: 22px;
    font-family: 'Poppins', sans-serif;
}

.navbar-brand:hover {
    color: var(--primary);
}

.navbar-search {
    width: 500px;
    height: 48px;
    position: relative;
    background-color: var(--bg);
    border-radius: 100px;
}

.navbar-search input {
    width: 100%;
    height: 100%;
    padding: 0 1rem 0 3rem;
    border: none;
    border-radius: 100px;
    font-size: 14px;
    background-color: var(--bg);
    transition: var(--transition);
    font-family: 'Poppins', sans-serif;
}

.navbar-search input::placeholder {
    color: var(--text-secondary);
}

.navbar-search input:focus {
    outline: none;
    background-color: #fff;
    box-shadow: 0 0 0 3px rgba(255, 82, 0, 0.1);
}

.navbar-search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-secondary);
    font-size: 16px;
}

.navbar-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.navbar-nav a {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    transition: var(--transition);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-btn);
    font-family: 'Poppins', sans-serif;
}

.navbar-nav a:hover {
    background-color: var(--bg);
}

.cart-icon {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-btn);
    transition: var(--transition);
    font-family: 'Poppins', sans-serif;
}

.cart-icon:hover {
    background-color: var(--bg);
}

.cart-count {
    background-color: var(--primary);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 100px;
    min-width: 20px;
    text-align: center;
}

/* ============================================
   Category Filter Chips
   ============================================ */
.categories {
    padding: 2rem 0;
    background-color: #fff;
    border-bottom: 1px solid var(--border);
}

.categories-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.categories-container::-webkit-scrollbar {
    display: none;
}

.category-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 12px 20px;
    background-color: #fff;
    border: 1px solid var(--border);
    border-radius: 100px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
    font-family: 'Poppins', sans-serif;
}

.category-chip:hover {
    background-color: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
}

.category-chip.active {
    background-color: var(--primary);
    color: #fff;
    border: none;
}

/* ============================================
   Promotional Banner
   ============================================ */
.promo-banner {
    background: linear-gradient(135deg, #FF5200, #FF8C42);
    padding: 2rem;
    margin: 2rem auto;
    max-width: 1200px;
    border-radius: var(--radius-card);
    margin-left: 24px;
    margin-right: 24px;
    color: #fff;
    text-align: center;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
}

.promo-banner:hover {
    transform: scale(1.01);
}

.promo-banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(circle at 20% 80%, rgba(255, 255, 255, 0.05) 0%, transparent 50%),
                      radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    pointer-events: none;
}

.promo-banner h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 1;
}

.promo-banner p {
    font-size: 1rem;
    opacity: 0.95;
    position: relative;
    z-index: 1;
}

.promo-banner .claim-btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid #fff;
    border-radius: var(--radius-btn);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition);
    font-family: 'Poppins', sans-serif;
    position: relative;
    z-index: 1;
}

.promo-banner .claim-btn:hover {
    background-color: #fff;
    color: var(--primary);
}

/* ============================================
   Restaurant Cards
   ============================================ */
.restaurants-section {
    padding: 2rem 0;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    margin-bottom: 40px;
}

.section-title {
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Poppins', sans-serif;
}

.section-title::after {
    content: '';
    display: block;
    width: 48px;
    height: 4px;
    background-color: var(--primary);
    border-radius: 2px;
    margin-left: 10px;
}

.restaurants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
}

.restaurant-card {
    background-color: var(--card-bg);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.25s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    position: relative;
}

.restaurant-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
}

.restaurant-image-container {
    position: relative;
    overflow: hidden;
    height: 200px;
}

.restaurant-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.restaurant-card:hover .restaurant-image {
    transform: scale(1.08);
}

.restaurant-badge {
    position: absolute;
    top: 0;
    left: 0;
    background-color: var(--primary);
    color: #fff;
    padding: 6px 10px;
    border-radius: 0 0 8px 0;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.restaurant-info {
    padding: 16px;
}

.restaurant-name {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 4px;
    color: var(--text-primary);
    line-height: 1.4;
    font-family: 'Poppins', sans-serif;
}

.restaurant-cuisine {
    font-size: 13px;
    color: var(--text-secondary);
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
}

.restaurant-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
}

.restaurant-meta span {
    color: var(--text-secondary);
}

.restaurant-meta .divider {
    color: var(--border);
}

.rating {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background-color: var(--green);
    color: #fff;
    padding: 6px 12px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 12px;
}

.rating-star {
    font-size: 10px;
}

/* ============================================
   Auth Forms (Sign Up / Login)
   ============================================ */
.auth-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #fff3ee, #ffe8d6);
    padding: 2rem;
}

.auth-card {
    background-color: #fff;
    border-radius: 24px;
    padding: 48px 40px;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 8px 40px rgba(255,82,0,0.12);
    animation: fadeUp 0.5s ease;
}

.auth-header {
    text-align: center;
    margin-bottom: 32px;
}

.auth-header h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-family: 'Poppins', sans-serif;
}

.auth-header p {
    color: var(--text-secondary);
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
}

.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
}

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;
    height: 50px;
    padding: 0 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-input);
    font-size: 15px;
    transition: var(--transition);
    font-family: 'Poppins', sans-serif;
    background-color: #fff;
    color: var(--text-primary);
}

.form-group textarea {
    height: 90px;
    padding: 12px 16px;
    resize: none;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: var(--text-secondary);
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(255,82,0,0.1);
}

.auth-btn {
    width: 100%;
    height: 52px;
    background-color: var(--primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-input);
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Poppins', sans-serif;
    margin-top: 8px;
}

.auth-btn:hover {
    background-color: var(--primary-dark);
    transform: translateY(-1px);
}

.auth-btn:active {
    transform: translateY(0);
}

.auth-footer {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
}

.auth-footer p {
    color: var(--text-secondary);
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
}

.auth-footer a {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
}

.auth-footer a:hover {
    text-decoration: underline;
}

/* ============================================
   Menu/Food Item Cards
   ============================================ */
.menu-section {
    padding: 2rem 0;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
}

.food-item-card {
    background-color: var(--card-bg);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: all 0.25s ease;
    border: 1px solid var(--border);
}

.food-item-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
}

.food-item-image-container {
    position: relative;
    overflow: hidden;
    height: 200px;
}

.food-item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.food-item-card:hover .food-item-image {
    transform: scale(1.08);
}

.food-item-info {
    padding: 16px;
}

.food-item-name {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-family: 'Poppins', sans-serif;
}

.food-item-description {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
}

.food-item-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.food-item-price {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    font-family: 'Poppins', sans-serif;
}

.veg-icon {
    width: 16px;
    height: 16px;
    border: 2px solid var(--green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
}

.veg-icon::after {
    content: '';
    width: 8px;
    height: 8px;
    background-color: var(--green);
    border-radius: 2px;
}

.non-veg-icon {
    width: 16px;
    height: 16px;
    border: 2px solid #FF4D4F;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
}

.non-veg-icon::after {
    content: '';
    width: 8px;
    height: 8px;
    background-color: #FF4D4F;
    border-radius: 50%;
}

.add-to-cart-btn {
    width: 100%;
    padding: 0.75rem;
    margin-top: 1rem;
    background-color: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-btn);
    color: var(--primary);
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
    font-size: 15px;
    font-family: 'Poppins', sans-serif;
}

.add-to-cart-btn:hover {
    background-color: var(--primary);
    color: #fff;
    border-color: var(--primary);
}

/* ============================================
   Cart Page
   ============================================ */
.cart-page {
    max-width: 14pxpx;
    margin: 2rem auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2rem;
}

.cart-items {
    background-color: var(--card-background);
    border-radiu0 2px 8px  gb-(0,0,0,0.06-card);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
}

.cart-summary {
    background-color: var(--card-background);
    border-radiu0 2px 8px  gbav0,0,0,0.06-card);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    height: fit-content;
    position: sticky;
    top: 100px;
    border: 1px solid var(--border-color);
}

.cart-item {
    display: flex;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-color);
}

.cart-item:last-child {
    border-bottom: none;
}

.cart-item-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: var(--radius-button);
}

.cart-item-info {
    flex: 1;
}

.cart-item-name {
    font-weight: 600;;
    font-family: 'Poppins', sans-serif
    margin-bottom: 0.25rem;
    color: var(--text-primary);
}

.cart-item-price {;
    font-family: 'Poppins', sans-serif
    color: var(--primary-color);
    font-weight: 600;
}

.summary-row {
    display: flex;
    justify-con1tpxpace-between;
    padding: 0.75rem 0;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
}

.summary-row.total {
    border-top: 2px solid var(--border-color);
    margin-top: 1rem;
    padding-top10px;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text-primary);
}

.checkout-btn {
    width: 100%;
    padding#fff
    background-color: var(--primary-color);
    color: var(--white);
    border: none6px
    border-radius: var(--radius-button);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: v'Poppans', sars-s--tfansition);
    margin-top: 1.5rem;
    font-family: inherit;
}
